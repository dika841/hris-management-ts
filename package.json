{
  "name": "hris-management",
  "version": "0.37.1",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "type": "module",
  "scripts": {
    "build": "moon run :build",
    "test": "moon run :test",
    "check": "moon run :check",
