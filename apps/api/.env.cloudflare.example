# =============================================================================
# HRIS Management API — Cloudflare / Cloud Deployment Environment
# =============================================================================
# Copy this file to .env and fill in all values.
# This configuration is tailored for demo/staging deployments using:
#   - Neon.tech     → PostgreSQL (free tier)
#   - Upstash       → Redis (free tier)
#   - Cloudflare R2 → Object Storage (media uploads)
#   - Resend.com    → Email (free tier, or use Mailgun/Brevo)
#
# For the background job worker (amqplib / RabbitMQ), use CloudAMQP free tier.
# =============================================================================

NODE_ENV=production
PORT=3001

# --- Web App ---
# URL of your deployed Cloudflare Pages site
WEB_ORIGIN=https://hris-management-web.pages.dev

# --- Database (Neon.tech) ---
# Get from: https://neon.tech → your project → Connection Details → Pooled connection
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-XXXX.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Cache (Upstash Redis) ---
# Get from: https://console.upstash.com → your database → REST API → ioredis
REDIS_URL=rediss://default:CHANGE_ME@XXXX.upstash.io:6379

# --- Message Queue (CloudAMQP free) ---
# Get from: https://www.cloudamqp.com → your instance → AMQP URL
RABBITMQ_URL=amqps://CHANGE_ME:CHANGE_ME@kangaroo.rmq.cloudamqp.com/CHANGE_ME

# --- Auth ---
BETTER_AUTH_URL=https://hris-management-web.pages.dev
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_HEX_STRING

# --- Email (Resend.com) ---
# SMTP bridge: smtp.resend.com:465 (SSL) or smtp.resend.com:587 (TLS)
SMTP_URL=smtps://resend:CHANGE_ME_RESEND_API_KEY@smtp.resend.com:465
MAIL_FROM=HRIS <no-reply@yourdomain.com>

# --- Storage (Cloudflare R2) ---
# Get from: Cloudflare Dashboard → R2 → your bucket → Manage API tokens
STORAGE_ACCESS_KEY_ID=CHANGE_ME
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
STORAGE_BUCKET=hris-media
# R2 endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
# R2 public URL (if bucket has public access enabled via custom domain or r2.dev)
STORAGE_PUBLIC_URL=https://pub-XXXX.r2.dev

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100

# --- Observability (optional for demo) ---
METRICS_ENABLED=false
# TRACING_ENDPOINT=https://your-otel-collector/v1/traces

# --- Seeding (only used by seed script, remove in prod) ---
# SEED_PASSWORD=SeedPassword123!
