{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hris-management-api",
  "account_id": "f441166e3929e4be7fbbd3174ec4a002",
  "main": "src/main.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "api-hris.randika.dev", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BETTER_AUTH_URL": "https://api-hris.randika.dev",
    "WEB_ORIGIN": "https://hris.randika.dev"
  }
}
