# Values for docker-compose.staging.yml. Copy to .env.staging on the host and fill it in.
# This file configures the compose stack, not the api: the api reads what compose passes it.

# The image to run. Build and push it, then pin the tag rather than tracking latest,
# so a redeploy cannot quietly pick up a different build.
STANDARD_IMAGE=standard:0.0.0

# Public URLs. Both must be HTTPS: envSchema refuses to start in production otherwise.
WEB_ORIGIN=https://staging.example.com
BETTER_AUTH_URL=https://staging.example.com

# Secrets. Generate fresh ones for staging, never reuse production's.
# openssl rand -base64 48
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
# Guards /metrics, which is served on the same origin as the app. At least 32 characters.
# The api refuses to start in production without it unless METRICS_ENABLED is false.
METRICS_TOKEN=

# Mail. Use a provider sandbox or a catch-all inbox: staging must not send to real people.
SMTP_URL=
MAIL_FROM="Standard Staging <no-reply@staging.example.com>"

# Optional
ACTIVITY_RETENTION_DAYS=90
RATE_LIMIT_TRUSTED_PROXY_IPS=
LOG_LEVEL=info
LOG_TRANSPORT_TARGET=
LOG_TRANSPORT_OPTIONS=
METRICS_ENABLED=true
# Tracing is off until an OTLP over HTTP traces endpoint is named here.
TRACING_ENDPOINT=
TRACING_HEADERS=
TRACING_SAMPLE_RATIO=1
